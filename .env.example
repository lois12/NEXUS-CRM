# ============================================
# NEXUS CRM — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=8080
NODE_ENV=production

# CORS — your domain
ALLOWED_ORIGIN=https://nexus-liberty.online

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING

# GigaChat AI API key
GIGACHAT_API_KEY=

# VAPID keys for push notifications — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
